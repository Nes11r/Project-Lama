# Gizli açarlar və mühitə xas parametrlər (kopyalayın: cp .env.example .env)
# İstifadə olunan bütün mənbələr (Open-Meteo, WorldPop, Overpass) hazırda açarsızdır.
# Open-Meteo kommersiya planı istifadə edilərsə:
# OPEN_METEO_API_KEY=
# Alternativ konfiqurasiya faylı:
# GASFC_CONFIG=/app/config.yaml
# Docker ilk işə salmada hava datasının son tarixi:
WEATHER_END=2024-08-31
